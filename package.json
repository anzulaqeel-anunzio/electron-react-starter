{
    "name": "electron-react-starter",
    "version": "1.0.0",
    "main": "main.js",
    "homepage": "./",
    "scripts": {
        "start": "concurrently \"cross-env BROWSER=none npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
        "react-start": "react-scripts start",
        "build": "react-scripts build",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.anunzio.electron-react-starter",
        "files": [
            "build/**/*",
            "main.js",
            "preload.js"
        ],
        "directories": {
            "buildResources": "assets"
        }
    },
    "keywords": [
        "electron",
        "react",
        "desktop",
        "boilerplate"
    ],
    "author": "Anzul Aqeel",
    "license": "MIT",
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-scripts": "5.0.1"
    },
    "devDependencies": {
        "concurrently": "^8.2.0",
        "cross-env": "^7.0.3",
        "electron": "^25.3.0",
        "electron-builder": "^24.4.0",
        "wait-on": "^7.0.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}